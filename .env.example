APP_NAME=parse-agent
APP_ENV=dev
LOG_LEVEL=INFO

# LangChain 模型配置，后续接入 Agent 时填写
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
PDF_NORMAL_PROVIDER=pdf.normal.pdf-inspector
PDF_FALLBACK_PROVIDERS=
WORD_NORMAL_PROVIDER=word.normal.mammoth
WORD_FALLBACK_PROVIDERS=
OFFICE_CONVERTER_PROVIDER=office.convert.libreoffice
OFFICE_CONVERTER_COMMAND=soffice
OFFICE_CONVERTER_TIMEOUT_SECONDS=300

# 媒体预处理：仅探测、音轨提取和标准化；不执行 ASR。
MEDIA_PREPARE_PROVIDER=media.prepare.ffmpeg
MEDIA_FFMPEG_COMMAND=ffmpeg
MEDIA_FFPROBE_COMMAND=ffprobe
MEDIA_TIMEOUT_SECONDS=300
MEDIA_MAX_DURATION_SECONDS=14400
MEDIA_MAX_FILE_SIZE_MB=2048

EXCEL_NORMAL_PROVIDER=excel.normal.openpyxl
EXCEL_MAX_SHEETS=30
EXCEL_MAX_SEMANTIC_CELLS=1000000
EXCEL_MAX_SHEET_ROWS=100000
EXCEL_MAX_COLUMNS=1000
EXCEL_MAX_FILE_SIZE_MB=100
EXCEL_MAX_UNCOMPRESSED_SIZE_MB=500
EXCEL_MAX_ZIP_ENTRIES=10000
EXCEL_MAX_SHEET_XML_SIZE_MB=100
PPT_NORMAL_PROVIDER=ppt.normal.python-pptx

# 单进程内存任务队列：服务重启时任务状态不保留。
TASK_QUEUE_ENABLED=true
TASK_MAX_CONCURRENT_EXECUTIONS=2
TASK_QUEUE_MAX_SIZE=100
TASK_DEFAULT_TIMEOUT_SECONDS=1800
TASK_RESULT_TTL_SECONDS=86400
TASK_CLEANUP_INTERVAL_SECONDS=300
TASK_CALLBACK_TIMEOUT_SECONDS=15

# 受控本地文件存储与轻量安全边界。
FILE_STORAGE_DIR=./data/files
FILE_MAX_SIZE_MB=100
FILE_ALLOWED_SUFFIXES=.pdf,.doc,.docx,.xls,.xlsx,.xlsm,.ppt,.pptx,.txt,.md,.markdown,.csv,.tsv,.html,.htm,.xml,.rtf,.mp3,.wav,.m4a,.aac,.flac,.ogg,.mp4,.mov,.mkv,.avi,.webm
# 留空则不启用 API Key 鉴权。
API_KEY=

TEXT_MAX_FILE_SIZE_MB=20
TEXT_MAX_TABLE_ROWS=100000
TEXT_MAX_TABLE_COLUMNS=1000

# RTF 智能路由：auto=复杂 RTF 转 DOCX，direct=仅直接文本，convert=总是转 DOCX。
RTF_ROUTING_MODE=auto
RTF_DIRECT_MAX_COMPLEXITY_SCORE=5
RTF_DIRECT_MAX_SIZE_MB=2
RTF_DIRECT_MIN_TEXT_RATIO=0.01
